# Apache .htaccess para el sitio (carpeta raíz de web/)

Options -Indexes

# Cabeceras de seguridad (antes solo estaban en web/api/.htaccess, así que
# solo protegían las respuestas JSON — las páginas HTML no tenían ninguna).
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Content-Security-Policy en modo "Report-Only" a propósito: el sitio usa
# bastantes onclick="" inline en el HTML, así que un CSP que los bloqueara
# de verdad (sin 'unsafe-inline') rompería la página. En modo Report-Only
# el navegador NO bloquea nada — solo avisa en la consola de DevTools qué
# violaría la política — así se puede revisar antes de activarla en serio
# más adelante (ver ANALISIS_SEGURIDAD.md, hallazgo #3).
Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"

# Redirección forzada a HTTPS.
# IMPORTANTE: deja esto COMENTADO hasta confirmar que el candado SSL ya
# funciona en el dominio (cPanel → "Certificado SSL" → debe decir activo,
# y https://tudominio.com debe cargar sin advertencias en el navegador).
# Si activas esto antes de tener el SSL listo, el sitio queda inaccesible
# (redirige a una versión https:// que todavía no existe).
#
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#
# HSTS: le dice al navegador que en las próximas visitas vaya DIRECTO a
# https:// sin pasar por http:// primero. Actívalo junto con el redirect
# de arriba (no antes) — si lo activas sin HTTPS funcionando, el navegador
# igual intentará forzar https:// y el sitio quedaría inaccesible.
# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
